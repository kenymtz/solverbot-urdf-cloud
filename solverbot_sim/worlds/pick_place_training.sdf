<?xml version="1.0"?>
<!-- GENERADO por solverbot_sim/tools/make_worlds.py: no editar a mano. Gazebo Harmonic (gz-sim 8). -->
<sdf version="1.10">
  <world name="pick_place_training">
    <physics name="default_physics" default="true" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.75 0.8 0.9 1</background><grid>false</grid></scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 0.2 -0.9</direction>
    </light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry><material><ambient>0.5500 0.5700 0.5500 1.0</ambient><diffuse>0.5500 0.5700 0.5500 1.0</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
    </link></model>
<model name="training_table"><static>true</static><pose>0.1500 0.6200 0.0000 0 0 0.0000</pose><link name="link"><visual name="top_v"><pose>0.0000 0.0000 0.7250 0.0000 0.0000 0.0000</pose><geometry><box><size>0.8000 0.5000 0.0300</size></box></geometry><material><ambient>0.5500 0.3600 0.2000 1.0</ambient><diffuse>0.5500 0.3600 0.2000 1.0</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="top_c"><pose>0.0000 0.0000 0.7250 0.0000 0.0000 0.0000</pose><geometry><box><size>0.8000 0.5000 0.0300</size></box></geometry><surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface></collision><visual name="leg0_v"><pose>0.3600 0.2100 0.3550 0.0000 0.0000 0.0000</pose><geometry><box><size>0.0400 0.0400 0.7100</size></box></geometry><material><ambient>0.5500 0.3600 0.2000 1.0</ambient><diffuse>0.5500 0.3600 0.2000 1.0</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="leg0_c"><pose>0.3600 0.2100 0.3550 0.0000 0.0000 0.0000</pose><geometry><box><size>0.0400 0.0400 0.7100</size></box></geometry></collision><visual name="leg1_v"><pose>0.3600 -0.2100 0.3550 0.0000 0.0000 0.0000</pose><geometry><box><size>0.0400 0.0400 0.7100</size></box></geometry><material><ambient>0.5500 0.3600 0.2000 1.0</ambient><diffuse>0.5500 0.3600 0.2000 1.0</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="leg1_c"><pose>0.3600 -0.2100 0.3550 0.0000 0.0000 0.0000</pose><geometry><box><size>0.0400 0.0400 0.7100</size></box></geometry></collision><visual name="leg2_v"><pose>-0.3600 0.2100 0.3550 0.0000 0.0000 0.0000</pose><geometry><box><size>0.0400 0.0400 0.7100</size></box></geometry><material><ambient>0.5500 0.3600 0.2000 1.0</ambient><diffuse>0.5500 0.3600 0.2000 1.0</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="leg2_c"><pose>-0.3600 0.2100 0.3550 0.0000 0.0000 0.0000</pose><geometry><box><size>0.0400 0.0400 0.7100</size></box></geometry></collision><visual name="leg3_v"><pose>-0.3600 -0.2100 0.3550 0.0000 0.0000 0.0000</pose><geometry><box><size>0.0400 0.0400 0.7100</size></box></geometry><material><ambient>0.5500 0.3600 0.2000 1.0</ambient><diffuse>0.5500 0.3600 0.2000 1.0</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual><collision name="leg3_c"><pose>-0.3600 -0.2100 0.3550 0.0000 0.0000 0.0000</pose><geometry><box><size>0.0400 0.0400 0.7100</size></box></geometry></collision></link></model>
<model name="target_zone"><static>true</static><pose>0.3300 0.4500 0.0000 0 0 0.0000</pose><link name="link"><visual name="mark_v"><pose>0.0000 0.0000 0.7410 0.0000 0.0000 0.0000</pose><geometry><box><size>0.1200 0.1200 0.0020</size></box></geometry><material><ambient>0.1000 0.8000 0.2000 1.0</ambient><diffuse>0.1000 0.8000 0.2000 1.0</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
<model name="pick_object"><pose>0.2200 0.5600 0.7620 0 0 0</pose><plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher"><publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><update_frequency>100</update_frequency></plugin><link name="link"><inertial><mass>0.06</mass><inertia><ixx>1.600e-05</ixx><iyy>1.600e-05</iyy><izz>1.600e-05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><collision name="c"><geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction><contact><ode><kp>1e6</kp><kd>100</kd><min_depth>0.001</min_depth></ode></contact></surface></collision><visual name="v"><geometry><box><size>0.0400 0.0400 0.0400</size></box></geometry><material><ambient>0.8500 0.1000 0.1000 1.0</ambient><diffuse>0.8500 0.1000 0.1000 1.0</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual></link></model>
  </world>
</sdf>
