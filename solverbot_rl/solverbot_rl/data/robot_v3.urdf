        <box size="0.03 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="5.816666666666667e-05" ixy="0" ixz="0" iyy="1.0166666666666667e-05" iyz="0" izz="5.9999999999999995e-05"/>
    </inertial>
  </link>
  <joint name="arm_camera_mount_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="arm_camera_link"/>
    <origin rpy="0 0 0" xyz="0.025 0.0 0.08"/>
  </joint>
  <link name="arm_camera_optical_frame"/>
  <joint name="arm_camera_optical_joint" type="fixed">
    <parent link="arm_camera_link"/>
    <child link="arm_camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <link name="pan_tilt_base_link">
