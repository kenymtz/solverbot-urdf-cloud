      <inertia ixx="7.575e-05" ixy="0" ixz="0" iyy="7.575e-05" iyz="0" izz="0.00015"/>
    </inertial>
  </link>
  <joint name="pan_tilt_base_joint" type="fixed">
    <parent link="torso_column"/>
    <child link="pan_tilt_base_link"/>
    <origin rpy="0 0 0" xyz="0.0381 -0.0003 0.9911"/>
  </joint>
  <link name="pan_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_v3_description/meshes/structure/pan.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.01905"/>
      <geometry>
        <box size="0.034 0.0285 0.0381"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.01905"/>
      <mass value="0.15"/>
      <inertia ixx="2.8298250000000006e-05" ixy="0" ixz="0" iyy="3.2595125000000004e-05" iyz="0" izz="2.4603125000000007e-05"/>
    </inertial>
  </link>
  <joint name="pan_joint" type="revolute">
    <parent link="pan_tilt_base_link"/>
    <child link="pan_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.5" lower="-1.5708" upper="1.5708" velocity="3.14"/>
  </joint>
  <!-- Soporte de tilt: une el eje de tilt con la cámara -->
  <link name="tilt_link">
    <visual>
