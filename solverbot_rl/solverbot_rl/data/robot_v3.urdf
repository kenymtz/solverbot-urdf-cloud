    </inertial>
  </link>
  <joint name="tilt_joint" type="revolute">
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.0381"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.5" lower="-0.7854" upper="0.7854" velocity="3.14"/>
