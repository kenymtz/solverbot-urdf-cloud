  <joint name="joint7" type="prismatic">
    <origin rpy="1.5707963 0 0" xyz="0 0 0.1358"/>
    <parent link="gripper_base"/>
    <child link="link7"/>
    <axis xyz="0 0 1"/>
    <limit effort="10.0" lower="0.0" upper="0.035" velocity="1.0"/>
  </joint>
  <!-- La pinza tiene UN grado de libertad: joint7 es la apertura de cada dedo y joint8 la copia con signo opuesto.
         Relación oficial de AgileX (agx_arm_urdf, piper_with_gripper_description.xacro): dedo1 = +0.5·gripper,
         dedo2 = -0.5·gripper, con los mismos orígenes, ejes y mallas que joint7/joint8 -> joint8 = -1 · joint7.
         Coincide con lo que publica la Jetson: joint7 = +apertura/2, joint8 = -apertura/2. -->
  <joint name="joint8" type="prismatic">
    <origin rpy="1.5707963 0 -3.1415926" xyz="0 0 0.1358"/>
    <parent link="gripper_base"/>
    <child link="link8"/>
    <axis xyz="0 0 -1"/>
    <limit effort="10.0" lower="-0.035" upper="0.0" velocity="1.0"/>
    <mimic joint="joint7" multiplier="-1.0" offset="0"/>
  </joint>
  <!-- Punto central de herramienta entre los dedos (base_athome / piper_ros) -->
  <link name="tcp_link"/>
  <joint name="link6_to_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.1358"/>
    <parent link="link6"/>
    <child link="tcp_link"/>
  </joint>
  <link name="arm_camera_link">
