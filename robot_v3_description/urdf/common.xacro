<?xml version="1.0"?>
<!-- Propiedades, materiales y macros comunes de robot_v3 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="pkg" value="package://robot_v3_description"/>
  <xacro:property name="G" value="${xacro.load_yaml('$(find robot_v3_description)/config/geometry_v3.yaml')}"/>
  <xacro:property name="S" value="${xacro.load_yaml('$(find robot_v3_description)/config/sim_provisional.yaml')}"/>
  <xacro:property name="PL" value="${xacro.load_yaml('$(find robot_v3_description)/config/piper_limits.yaml')}"/>

  <!-- Lista [x, y, z] -> "x y z" -->
  <xacro:property name="xyz_str" value="${lambda v: ' '.join(str(float(c)) for c in v)}"/>

  <material name="orbbec_black"><color rgba="0.08 0.08 0.08 1.0"/></material>

  <!-- Geometría visual de la estructura: un DAE por link (meshes/structure/<grupo>.dae), generado desde las primitivas
       de config/visual_v3.yaml con tools/make_structure_visuals.py. Un único <visual> por link porque RViz2 aplica el
       material de la primera <visual> a todas las del link. Los colores van dentro del DAE. -->
  <xacro:macro name="visual_parts" params="group">
    <visual>
      <geometry><mesh filename="${pkg}/meshes/structure/${group}.dae"/></geometry>
    </visual>
  </xacro:macro>

  <!-- Inercias de sólidos homogéneos (masa provisional de config/sim_provisional.yaml) -->
  <xacro:macro name="box_inertial" params="m size xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(size[1]**2+size[2]**2)/12}" ixy="0" ixz="0"
               iyy="${m*(size[0]**2+size[2]**2)/12}" iyz="0" izz="${m*(size[0]**2+size[1]**2)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- Cilindro con eje Y (ruedas) -->
  <xacro:macro name="cylinder_y_inertial" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r**2+h**2)/12}" ixy="0" ixz="0" iyy="${m*r**2/2}" iyz="0" izz="${m*(3*r**2+h**2)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="m r">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r**2/5}" ixy="0" ixz="0" iyy="${2*m*r**2/5}" iyz="0" izz="${2*m*r**2/5}"/>
    </inertial>
  </xacro:macro>

</robot>
