<?xml version="1.0"?>
<!--
  ros2_control para SIMULACIÓN. No hay hardware real en este archivo: nunca habla con CAN, el ESP32,
  los Dynamixel ni el hoverboard.
    mode = mock   -> mock_components/GenericSystem: el estado sigue al comando (sin física).
    mode = gazebo -> ign_ros2_control/IgnitionSystem (Ignition Gazebo Fortress, ROS 2 Humble).
    mode = gz     -> gz_ros2_control/GazeboSimSystem (Gazebo Harmonic, ROS 2 Jazzy).
  El hardware real se integra por /joint_states (launch/real_state.launch.py), no por este archivo.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="position_joint" params="name initial:=0.0">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">${initial}</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="robot_v3_ros2_control" params="mode gripper_servo:=mimic">
    <xacro:if value="${gripper_servo not in ['mimic', 'dual'] or (gripper_servo == 'dual' and mode != 'gz')}">
      ${xacro.fatal('gripper_servo: mimic | dual (dual solo con ros2_control:=gz); recibido ' + gripper_servo)}
    </xacro:if>
    <ros2_control name="robot_v3_sim" type="system">
      <hardware>
        <xacro:if value="${mode == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${mode == 'gazebo'}">
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
        </xacro:if>
        <xacro:if value="${mode == 'gz'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
      </hardware>

      <!-- Ruedas: en Gazebo las mueve diff_drive_controller; en mock solo publican estado (0) -->
      <xacro:macro name="wheel" params="side">
        <joint name="${side}_wheel_joint">
          <xacro:if value="${mode in ['gazebo', 'gz']}"><command_interface name="velocity"/></xacro:if>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:wheel side="left"/>
      <xacro:wheel side="right"/>

      <xacro:position_joint name="torso_lift_joint"/>
      <xacro:position_joint name="joint1"/>
      <xacro:position_joint name="joint2"/>
      <xacro:position_joint name="joint3"/>
      <xacro:position_joint name="joint4"/>
      <xacro:position_joint name="joint5"/>
      <xacro:position_joint name="joint6"/>
      <xacro:position_joint name="joint7"/>
      <!-- joint8 = -1 · joint7 (mimic en el URDF). Sin interfaz de comando: la pinza tiene una sola orden lógica.
           Humble (ros2_control 2.x, mock e ign_ros2_control) toma la relación de estos parámetros;
           Jazzy (4.x) la toma del <mimic> del URDF. -->
      <xacro:unless value="${gripper_servo == 'dual'}">
        <joint name="joint8">
          <param name="mimic">joint7</param>
          <param name="multiplier">-1</param>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:unless>
      <!-- SOLO SIMULACIÓN (gz): el mimic emulado por gz_ros2_control no ejerce fuerza propia en joint8 y, al apretar un
           objeto, el par de dedos se desplaza en bloque hasta el tope de joint8 (Gazebo, 2026-10-27). En el Piper real
           ambos dedos están acoplados rígidamente a un solo motor; se emula con un servo de posición por dedo que
           recibe la MISMA orden espejada (la pinza sigue teniendo una sola orden lógica en el entorno). -->
      <xacro:if value="${gripper_servo == 'dual'}">
        <joint name="joint8" mimic="false">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>
      <xacro:position_joint name="pan_joint"/>
      <xacro:position_joint name="tilt_joint"/>
    </ros2_control>
  </xacro:macro>

</robot>
