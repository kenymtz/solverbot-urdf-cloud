<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Helpers comunes. G = config/robot_geometry.yaml (generado por tools/make_config_v2.py) -->
  <xacro:property name="pkg" value="package://robot_v2_description"/>

  <!-- Origen relativo entre dos marcos expresados en base_link (solo traslación) -->
  <xacro:macro name="rel_origin" params="child parent">
    <xacro:property name="c" value="${G['frames'][child]}"/>
    <xacro:property name="p" value="${G['frames'][parent]}"/>
    <origin xyz="${c[0]-p[0]} ${c[1]-p[1]} ${c[2]-p[2]}" rpy="0 0 0"/>
  </xacro:macro>

  <!-- Colisión simplificada: caja definida en el marco del link -->
  <xacro:macro name="box_collision" params="key">
    <xacro:property name="b" value="${G['collision'][key]}"/>
    <collision>
      <origin xyz="${b['center'][0]} ${b['center'][1]} ${b['center'][2]}" rpy="0 0 0"/>
      <geometry><box size="${b['size'][0]} ${b['size'][1]} ${b['size'][2]}"/></geometry>
    </collision>
  </xacro:macro>

  <!-- Link con malla escaneada texturizada (DAE) y colisión de caja -->
  <xacro:macro name="scan_link" params="name mesh">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${pkg}/meshes/visual/${mesh}.dae"/></geometry>
      </visual>
      <xacro:box_collision key="${name}"/>
      <xacro:estimated_inertial link="${name}"/>
    </link>
  </xacro:macro>
</robot>
