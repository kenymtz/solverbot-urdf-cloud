<?xml version="1.0"?>
<!-- Base diferencial: chasis, ruedas motrices (hoverboard) y ruedas locas traseras -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_footprint"/>

  <xacro:scan_link name="base_link" mesh="base"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Ruedas motrices: origen en el eje real (centro geométrico medido), eje de giro +Y como en el repo -->
  <xacro:macro name="drive_wheel" params="side">
    <xacro:property name="W" value="${G['wheels']}"/>
    <link name="${side}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${pkg}/meshes/visual/${side}_wheel.dae"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${W['collision_radius']}" length="${W['width']}"/></geometry>
      </collision>
      <xacro:estimated_inertial link="${side}_wheel"/>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <xacro:rel_origin child="${side}_wheel" parent="base_link"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:drive_wheel side="left"/>
  <xacro:drive_wheel side="right"/>

  <!-- Ruedas locas traseras (dos, pivotantes). Grados de libertad pasivos no modelados: fijas -->
  <xacro:macro name="rear_caster" params="side">
    <link name="rear_${side}_caster">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="${pkg}/meshes/visual/rear_${side}_caster.dae"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${G['casters']['collision_radius']}"/></geometry>
      </collision>
      <xacro:estimated_inertial link="rear_${side}_caster"/>
    </link>
    <joint name="rear_${side}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="rear_${side}_caster"/>
      <xacro:rel_origin child="rear_${side}_caster" parent="base_link"/>
    </joint>
  </xacro:macro>
  <xacro:rear_caster side="left"/>
  <xacro:rear_caster side="right"/>

</robot>
